{
  "name": "defter",
  "private": true,
  "version": "0.0.0",
  "description": "Google Drive notes (PDFs, notebook photos, AI summaries) as books in a 3D study room.",
  "repository": {
    "type": "git",
    "url": "https://github.com/denizyarpinar/defter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "demo-pdf": "node scripts/demo-pdf-uret.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "1.2.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "gifsicle": "^7.0.1",
    "playwright-core": "^1.64.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
